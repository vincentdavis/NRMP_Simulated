# Copy to .env for local development. Real environment variables take precedence over this file,
# and .env is never read on Railway.

# Development mode: debug pages, debug toolbar, a built-in development SECRET_KEY and a local
# SQLite database (db.sqlite3) when DATABASE_URL is unset. Never set this in production.
DEBUG=True

# Required when DEBUG is off (production):
# SECRET_KEY=<a long random value: python -c "import secrets; print(secrets.token_urlsafe(50))">
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional:
# ALLOWED_HOSTS=localhost,127.0.0.1,nrmp-simulated.heteroskedastic.org
# CSRF_TRUSTED_ORIGINS=https://example.org
# SECURE_HSTS_SECONDS=3600
# LOGFIRE_TOKEN=<Logfire write token; without it nothing is sent>
# Outgoing email (confirmation and password-reset links). Without EMAIL_HOST, emails go to the log:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=NRMP Simulations <noreply@example.com>
# Public contact address for account and data requests (contact and privacy pages):
# CONTACT_EMAIL=
# Reverse proxies in front of the app that append to X-Forwarded-For (1 on Railway, the default when DEBUG is off):
# TRUSTED_PROXY_COUNT=1
# Running the production image over plain http://localhost (docker-compose sets these):
# SECURE_SSL_REDIRECT=False
# SECURE_COOKIES=False
# Container start-up (entrypoint.sh): workers (default 2), request timeout in seconds (default 30), and
# MIGRATE_ON_START=1 to migrate at start-up instead of in Railway's pre-deploy command:
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=30
# MIGRATE_ON_START=0
# Largest applicants x programs product one simulation step may process (default 250000):
# NRMP_MAX_PAIRS=250000

# Tests use an in-memory SQLite database; point this at PostgreSQL to test against it:
# NRMP_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
