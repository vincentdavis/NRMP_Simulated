# Copy to .env for local development. Real environment variables take precedence over this file,
# and .env is never read on Railway.

# Development mode: debug pages, debug toolbar, a built-in development SECRET_KEY and a local
# SQLite database (db.sqlite3) when DATABASE_URL is unset. Never set this in production.
DEBUG=True

# Required when DEBUG is off (production):
# SECRET_KEY=<a long random value: python -c "import secrets; print(secrets.token_urlsafe(50))">
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional:
# ALLOWED_HOSTS=localhost,127.0.0.1,nrmp-simulated.heteroskedastic.org
# CSRF_TRUSTED_ORIGINS=https://example.org
# SECURE_HSTS_SECONDS=3600
# LOGFIRE_TOKEN=<Logfire write token; without it nothing is sent>
# Outgoing email (confirmation and password-reset links). Without EMAIL_HOST, emails go to the log:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=NRMP Simulations <noreply@example.com>
# Public contact address for account and data requests (contact and privacy pages):
# CONTACT_EMAIL=
# Reverse proxies in front of the app that append to X-Forwarded-For (1 on Railway, the default when DEBUG is off):
# TRUSTED_PROXY_COUNT=1
# Running the production image over plain http://localhost (docker-compose sets these):
# SECURE_SSL_REDIRECT=False
# SECURE_COOKIES=False
# Container start-up (entrypoint.sh): workers (default 2), request timeout in seconds (default 30), and
# MIGRATE_ON_START=1 to migrate at start-up instead of in Railway's pre-deploy command:
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=30
# MIGRATE_ON_START=0
# Background runs: immediate (inside the request, the default) or database (a worker service runs
# `manage.py nrmp_worker`):
# TASK_BACKEND=immediate
# Largest applicants x programs of one run, in the request and in the worker; pairs the engine computes at a time
# (memory, about 100 bytes each); largest market whose detail pages show the other side's ranks and offer the
# pairs CSV:
# NRMP_MAX_PAIRS=1000000
# NRMP_MAX_PAIRS_WORKER=10000000
# NRMP_BLOCK_PAIRS=250000
# NRMP_DRILLDOWN_MAX_PAIRS=2000000
# Quotas per account (staff exempt) and rate limits (count/period, period s, m, h or d):
# NRMP_REQUIRE_VERIFIED_EMAIL=False
# NRMP_MAX_SIMULATIONS=50
# NRMP_MAX_PRESETS=50
# NRMP_RUNS_PER_DAY=200
# NRMP_PAIRS_PER_DAY=200000000
# NRMP_RATE_SIGNUP=10/h
# NRMP_RATE_RUN=60/h
# NRMP_RATE_UPLOAD=60/h
# Downloads of the public example runs (/examples/), per client address:
# NRMP_RATE_EXAMPLE_DOWNLOAD=600/h
# Housekeeping (manage.py nrmp_cleanup): runs kept per simulation; minutes before a queued or running run counts as
# interrupted:
# NRMP_RUNS_KEPT=50
# NRMP_STALE_RUN_MINUTES=60
# Seconds a run may stay queued before its page warns that it has waited unusually long:
# NRMP_QUEUE_WARNING_SECONDS=60
# Absolute site address for links in emails sent by the worker and for the canonical addresses and the sitemap that
# search engines read (default: Railway's public domain):
# SITE_URL=
# Verification codes of Google Search Console and Bing Webmaster Tools (the content of their "HTML tag"):
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Tests use an in-memory SQLite database; point this at PostgreSQL to test against it:
# NRMP_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
