{
  "name": "theme",
  "version": "4.2.0",
  "description": "Tailwind CSS + daisyUI build, and the vendored htmx, Alpine.js and ECharts files",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:tailwind",
    "build:clean": "rimraf ../static/css/dist",
    "build:tailwind": "cross-env NODE_ENV=production postcss ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "dev": "cross-env NODE_ENV=development postcss ./src/styles.css -o ../static/css/dist/styles.css --watch",
    "vendor": "node vendor.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "alpinejs": "3.17.4",
    "echarts": "6.1.0",
    "htmx.org": "2.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.46",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3"
  }
}
